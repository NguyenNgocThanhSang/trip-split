# Mẫu biến môi trường (file này được commit, KHÔNG chứa giá trị thật).
# Tạo 2 file từ mẫu này (cả hai đều bị .gitignore nhờ *.local):
#
#   .env.local             → `npm run dev` với Firebase Emulator: để trống 4 biến Firebase, VITE_USE_EMULATOR=true
#   .env.production.local  → `npm run build` cho Cloudflare: điền cấu hình Firebase thật, VITE_USE_EMULATOR=false
#
# Vite mode production đọc .env.production.local sau .env.local nên giá trị prod luôn thắng khi build.
# 4 giá trị Firebase lấy ở: Firebase Console → Project settings → General → Your apps → Web app → SDK config.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Chỉ để UI ẩn/hiện nút admin; quyền thật nằm ở firestore.rules
VITE_ADMIN_UID=
VITE_USE_EMULATOR=true
