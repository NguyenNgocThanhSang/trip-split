/**
 * Luật bảo mật Cloud Firestore cho TripSplit (Spark plan, không dùng Cloud Functions).
 * Không bao giờ cho phép `list` trên `trips`, không cho khách đọc `friends` hay `memberSecrets`,
 * và không cho khách sửa thông tin chuyến/STK/QR hay giả mạo danh tính thành viên khác.
 */

// ===============================================================
// Assumed Data Model (Mô hình dữ liệu giả định — DESIGN.md §6 & §7.2)
// ===============================================================
//
// Tài liệu rules này giả định các collection và cấu trúc dữ liệu sau:
//
// 1. Collection: friends/{friendId} (CHỈ admin đọc/ghi)
//    - name: string (bắt buộc, 1..40 ký tự) - Tên hiển thị trong danh bạ
//    - bankBin: string (tùy chọn, đúng 6 chữ số NAPAS) - Mã BIN ngân hàng
//    - bankShortName: string (tùy chọn, 1..30 ký tự) - Tên ngắn ngân hàng
//    - accountNo: string (tùy chọn, 1..25 ký tự) - Số tài khoản ngân hàng
//    - accountName: string (tùy chọn, 1..60 ký tự) - Tên chủ tài khoản
//    - momoQrDataUrl: string (tùy chọn, <= 100.000 ký tự, data:image/(webp|jpeg|png);base64,...) - Ảnh QR MoMo đã nén
//    - createdAt: timestamp (bắt buộc, == request.time khi tạo, bất biến khi cập nhật)
//    - updatedAt: timestamp (bắt buộc, == request.time)
//
// 2. Collection: trips/{tripId} (tripId dài đúng 10 ký tự [a-z0-9])
//    - name: string (bắt buộc, 1..100 ký tự) - Tên chuyến đi
//    - startDate: string (tùy chọn, YYYY-MM-DD) - Ngày bắt đầu
//    - endDate: string (tùy chọn, YYYY-MM-DD) - Ngày kết thúc
//    - members: list (bắt buộc, 2..20 phần tử) - Bản sao thông tin thành viên & STK lúc tạo/cập nhật chuyến
//    - memberIds: list (bắt buộc, cùng độ dài với members) - Danh sách ID thành viên để rules kiểm tra `in` / `hasOnly`
//    - allowGuestExpenses: bool (bắt buộc) - Bật/tắt quyền thêm/sửa/xóa chi tiêu cho khách
//    - locked: bool (bắt buộc) - Khóa sổ chuyến đi (chặn mọi ghi từ khách)
//    - createdAt: timestamp (bắt buộc, == request.time khi tạo, bất biến khi cập nhật)
//    - updatedAt: timestamp (bắt buộc, == request.time)
//
// 3. Subcollection: trips/{tripId}/expenses/{expenseId}
//    - name: string (bắt buộc, 1..100 ký tự) - Tên khoản chi
//    - amount: int (bắt buộc, 1..1.000.000.000 VND) - Số tiền nguyên VND
//    - payerId: string (bắt buộc, thuộc trip.memberIds) - Người ứng tiền
//    - participantIds: list (bắt buộc, 1..20 phần tử, tập con trip.memberIds) - Người tham gia chia
//    - fixedAmounts: map (bắt buộc, keys tập con participantIds) - Phần chia cố định (nếu có)
//    - note: string (bắt buộc, 0..200 ký tự) - Ghi chú (chuỗi rỗng nếu không có)
//    - date: string (bắt buộc, YYYY-MM-DD) - Ngày chi tiêu
//    - createdBy: string (bắt buộc, 'admin' | 'guest', bất biến) - Nguồn tạo khoản chi
//    - createdByUid: string (tùy chọn, 1..128 ký tự, bất biến; bắt buộc == request.auth.uid khi createdBy == 'guest', cấm có khi 'admin') - Auth UID của khách tạo khoản chi
//    - createdByMemberId: string (tùy chọn, thuộc trip.memberIds, bất biến; bắt buộc == binding.memberId khi createdBy == 'guest', cấm có khi 'admin') - ID thành viên gắn với khách tạo khoản chi
//    - createdAt: timestamp (bắt buộc, == request.time khi tạo, bất biến khi cập nhật)
//    - updatedAt: timestamp (bắt buộc, == request.time)
//
// 4. Subcollection: trips/{tripId}/payments/{paymentId} (chỉ tạo/đọc/xóa, cấm sửa)
//    - fromId: string (bắt buộc, thuộc trip.memberIds) - Người trả tiền
//    - toId: string (bắt buộc, thuộc trip.memberIds, khác fromId) - Người nhận tiền
//    - amount: int (bắt buộc, 1..1.000.000.000 VND) - Số tiền thực tế đã chuyển
//    - note: string (bắt buộc, 0..120 ký tự) - Ghi chú thanh toán
//    - markedBy: string (bắt buộc, 'admin' | 'guest') - Nguồn ghi nhận thanh toán
//    - createdByUid: string (tùy chọn, 1..128 ký tự; bắt buộc == request.auth.uid khi markedBy == 'guest', cấm có khi 'admin') - Auth UID của khách ghi nhận thanh toán
//    - createdByMemberId: string (tùy chọn, thuộc trip.memberIds; bắt buộc == binding.memberId và thuộc {fromId, toId} khi markedBy == 'guest', cấm có khi 'admin') - ID thành viên của khách ghi nhận
//    - paidAt: timestamp (bắt buộc, == request.time) - Thời điểm ghi nhận thanh toán
//
// 5. Subcollection: trips/{tripId}/memberQrs/{memberId} (memberId thuộc trip.memberIds)
//    - dataUrl: string (bắt buộc, <= 100.000 ký tự, data:image/(webp|jpeg|png);base64,...) - Ảnh QR MoMo tĩnh
//    - updatedAt: timestamp (bắt buộc, == request.time)
//
// 6. Subcollection: trips/{tripId}/memberSecrets/{memberId} (CHỈ admin đọc/ghi/xóa; memberId thuộc trip.memberIds)
//    - code: string (bắt buộc, 12..32 ký tự [a-z0-9]) - Mã bí mật cá nhân nằm trong link mời riêng của thành viên
//    - updatedAt: timestamp (bắt buộc, == request.time) - Thời điểm tạo hoặc xoay vòng mã bí mật
//
// 7. Subcollection: trips/{tripId}/bindings/{uid} (uid là Firebase Auth UID của khách)
//    - memberId: string (bắt buộc, thuộc trip.memberIds) - Thành viên được liên kết với phiên khách
//    - code: string (bắt buộc, 12..32 ký tự [a-z0-9], phải khớp memberSecrets/{memberId}.code) - Mã bí mật chứng minh quyền sở hữu danh tính
//    - updatedAt: timestamp (bắt buộc, == request.time) - Thời điểm liên kết hoặc cập nhật binding
//
// ===============================================================

rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {

    // ---------- helpers ----------

    // Kiểm tra người gửi request có phải admin duy nhất (so UID cố định qua Firebase Auth) để cấp toàn quyền quản trị.
    function isAdmin() {
      return request.auth != null && request.auth.uid == 'BdmGrQUlwkdSxvcPNpNG1qIdKCk1';
    }

    // Trả về đường dẫn document chuyến đi dùng chung cho exists() và get() trong các subcollection.
    function tripPath(tripId) { return /databases/$(db)/documents/trips/$(tripId); }

    // Kiểm tra document chuyến đi cha có tồn tại hay không để chặn đọc/ghi vào subcollection mồ côi.
    function tripExists(tripId) { return exists(tripPath(tripId)); }

    // Đọc dữ liệu document chuyến đi cha để kiểm tra danh sách thành viên và trạng thái khóa/cho phép khách nhập.
    function trip(tripId) { return get(tripPath(tripId)).data; }

    // Kiểm tra số tiền phải là số nguyên VND hợp lệ trong khoảng 1..1 tỷ (chặn số âm, 0, float và tràn giới hạn).
    function isMoney(v)        { return v is int && v >= 1 && v <= 1000000000; }

    // Kiểm tra chuỗi bắt buộc có độ dài từ 1 tới max ký tự nhằm chống chuỗi rỗng và payload quá lớn.
    function isText(v, max)    { return v is string && v.size() >= 1 && v.size() <= max; }

    // Kiểm tra chuỗi cho phép rỗng có độ dài tối đa max ký tự nhằm giới hạn dung lượng lưu trữ.
    function isOptText(v, max) { return v is string && v.size() <= max; }

    // Kiểm tra chuỗi ngày theo đúng định dạng YYYY-MM-DD để đảm bảo dữ liệu ngày nhất quán.
    function isDate(v)         { return v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'); }

    // Kiểm tra ảnh QR MoMo dạng data URL base64 (webp/jpeg/png) và giới hạn <= 100.000 ký tự để không vượt ngưỡng 1 MiB.
    function isQrDataUrl(v) {
      return v is string && v.size() <= 100000
        && v.matches('^data:image/(webp|jpeg|png);base64,[A-Za-z0-9+/=]+$');
    }

    // Kiểm tra document có chính xác tập key cho phép (không thiếu trường bắt buộc, không thừa trường lạ).
    function exactKeys(d, keys) { return d.keys().hasOnly(keys) && d.keys().hasAll(keys); }

    // Trả về đường dẫn document chứa mã bí mật cá nhân của một thành viên trong chuyến đi.
    function secretPath(tripId, memberId) {
      return /databases/$(db)/documents/trips/$(tripId)/memberSecrets/$(memberId);
    }

    // Trả về đường dẫn document liên kết danh tính giữa UID khách và một thành viên trong chuyến đi.
    function bindingPath(tripId, uid) {
      return /databases/$(db)/documents/trips/$(tripId)/bindings/$(uid);
    }

    // Kiểm tra mã bí mật thành viên đúng định dạng 12..32 ký tự chữ thường và số [a-z0-9] để chống đoán mò và giới hạn kích thước.
    function isValidMemberCode(v) {
      return v is string && v.matches('^[a-z0-9]{12,32}$');
    }

    // Đối chiếu mã bí mật của thành viên với document memberSecrets tương ứng để xác thực quyền nhận danh tính.
    function secretMatches(tripId, memberId, code) {
      return memberId is string && code is string
        && exists(secretPath(tripId, memberId))
        && get(secretPath(tripId, memberId)).data.code == code;
    }

    // Kiểm tra người gọi hiện tại đã đăng nhập (kể cả ẩn danh) và có binding hợp lệ khớp memberIds lẫn mã bí mật hiện hành của chuyến.
    function hasValidBinding(tripId) {
      return request.auth != null
        && exists(bindingPath(tripId, request.auth.uid))
        && get(bindingPath(tripId, request.auth.uid)).data.memberId in trip(tripId).memberIds
        && secretMatches(
             tripId,
             get(bindingPath(tripId, request.auth.uid)).data.memberId,
             get(bindingPath(tripId, request.auth.uid)).data.code
           );
    }

    // Lấy memberId gắn với UID khách hiện tại từ document binding sau khi đã xác nhận binding hợp lệ.
    function myMemberId(tripId) {
      return get(bindingPath(tripId, request.auth.uid)).data.memberId;
    }

    // Đảm bảo một trường tùy chọn giữ nguyên trạng thái (cùng vắng mặt hoặc cùng có mặt với giá trị y hệt) khi cập nhật document.
    function sameOptField(after, before, key) {
      return (!(key in before) && !(key in after))
        || ((key in before) && (key in after) && after[key] == before[key]);
    }

    // ---------- validators ----------

    // Kiểm tra toàn bộ schema của document chuyến đi (trips) cho cả thao tác tạo và cập nhật bởi admin.
    function validTrip(d) {
      return d.keys().hasOnly(['name','startDate','endDate','members','memberIds',
                               'allowGuestExpenses','locked','createdAt','updatedAt'])
        && d.keys().hasAll(['name','members','memberIds','allowGuestExpenses','locked',
                            'createdAt','updatedAt'])
        && isText(d.name, 100)
        && (!('startDate' in d) || isDate(d.startDate))
        && (!('endDate' in d) || isDate(d.endDate))
        && d.members is list && d.members.size() >= 2 && d.members.size() <= 20
        && d.memberIds is list && d.memberIds.size() == d.members.size()
        && d.allowGuestExpenses is bool && d.locked is bool
        && d.updatedAt == request.time;
    }

    // Kiểm tra schema khoản chi (expenses), đối chiếu thành viên chuyến đi và giới hạn kích thước các trường tùy chọn định danh khách.
    function validExpense(d, t) {
      return d.keys().hasOnly(['name','amount','payerId','participantIds','fixedAmounts',
                               'note','date','createdBy','createdByUid','createdByMemberId',
                               'createdAt','updatedAt'])
        && d.keys().hasAll(['name','amount','payerId','participantIds','fixedAmounts',
                            'note','date','createdBy','createdAt','updatedAt'])
        && isText(d.name, 100)
        && isMoney(d.amount)
        && d.payerId in t.memberIds
        && d.participantIds is list
        && d.participantIds.size() >= 1 && d.participantIds.size() <= 20
        && d.participantIds.hasOnly(t.memberIds)
        && d.fixedAmounts is map
        && d.fixedAmounts.keys().hasOnly(d.participantIds)
        && isOptText(d.note, 200)
        && isDate(d.date)
        && (!('createdByUid' in d) || isText(d.createdByUid, 128))
        && (!('createdByMemberId' in d) || d.createdByMemberId in t.memberIds)
        && d.updatedAt == request.time;
      // Rules không lặp được giá trị trong map → kiểm từng fixed & tổng fixed ≤ amount ở client (computeShares).
    }

    // Kiểm tra schema bản ghi thanh toán (payments): người trả/nhận thuộc chuyến, khác nhau, tiền nguyên VND, giờ server và trường định danh khách nếu có.
    function validPayment(d, t) {
      return d.keys().hasOnly(['fromId','toId','amount','note','markedBy',
                               'createdByUid','createdByMemberId','paidAt'])
        && d.keys().hasAll(['fromId','toId','amount','note','markedBy','paidAt'])
        && d.fromId in t.memberIds && d.toId in t.memberIds && d.fromId != d.toId
        && isMoney(d.amount)
        && isOptText(d.note, 120)
        && (!('createdByUid' in d) || isText(d.createdByUid, 128))
        && (!('createdByMemberId' in d) || d.createdByMemberId in t.memberIds)
        && d.paidAt == request.time;
    }

    // Kiểm tra schema hồ sơ bạn bè trong danh bạ (friends) khi admin tạo hoặc cập nhật thông tin ngân hàng/QR.
    function validFriend(d) {
      return d.keys().hasOnly(['name','bankBin','bankShortName','accountNo','accountName',
                               'momoQrDataUrl','createdAt','updatedAt'])
        && d.keys().hasAll(['name','createdAt','updatedAt'])
        && isText(d.name, 40)
        && (!('bankBin' in d) || (d.bankBin is string && d.bankBin.matches('^[0-9]{6}$')))
        && (!('bankShortName' in d) || isText(d.bankShortName, 30))
        && (!('accountNo' in d) || isText(d.accountNo, 25))
        && (!('accountName' in d) || isText(d.accountName, 60))
        && (!('momoQrDataUrl' in d) || isQrDataUrl(d.momoQrDataUrl))
        && d.updatedAt == request.time;
    }

    // ---------- collections ----------

    match /friends/{friendId} {
      // Chỉ admin được đọc và xóa danh bạ vì chứa thông tin ngân hàng cá nhân của bạn bè.
      allow read, delete: if isAdmin();
      // Chỉ admin được tạo bạn bè mới khi hợp lệ schema và dùng timestamp máy chủ cho createdAt.
      allow create: if isAdmin() && validFriend(request.resource.data)
        && request.resource.data.createdAt == request.time;
      // Chỉ admin được cập nhật bạn bè khi hợp lệ schema và giữ nguyên createdAt bất biến.
      allow update: if isAdmin() && validFriend(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    match /trips/{tripId} {
      // Cho phép mọi người có link (kể cả khách không đăng nhập) đọc 1 chuyến theo tripId ngẫu nhiên 10 ký tự khó đoán.
      allow get: if true;
      // Chỉ admin được liệt kê toàn bộ danh sách chuyến để khách không thể dò ra các chuyến khác và STK bên trong.
      allow list: if isAdmin();
      // Chỉ admin được tạo chuyến mới với tripId đúng 10 ký tự [a-z0-9], hợp lệ schema và createdAt == request.time.
      allow create: if isAdmin()
        && tripId.matches('^[a-z0-9]{10}$')
        && validTrip(request.resource.data)
        && request.resource.data.createdAt == request.time;
      // Chỉ admin được sửa thông tin chuyến (thành viên, STK, khóa sổ, bật/tắt khách nhập) và không được đổi createdAt.
      allow update: if isAdmin()
        && validTrip(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt;
      // Chỉ admin được xóa chuyến đi.
      allow delete: if isAdmin();

      match /expenses/{expenseId} {
        // Bất kỳ ai có tripId của chuyến đang tồn tại đều đọc được danh sách chi tiêu của chuyến đó.
        allow read: if tripExists(tripId);

        // Cho phép tạo khoản chi hợp lệ khi chuyến tồn tại: admin ghi createdBy='admin' (không gắn UID/memberId khách), hoặc khách có binding hợp lệ ghi createdBy='guest' kèm đúng UID và memberId của mình khi chuyến mở và cho phép khách nhập.
        allow create: if tripExists(tripId)
          && validExpense(request.resource.data, trip(tripId))
          && request.resource.data.createdAt == request.time
          && ( (isAdmin()
                && request.resource.data.createdBy == 'admin'
                && !('createdByUid' in request.resource.data)
                && !('createdByMemberId' in request.resource.data))
            || (trip(tripId).allowGuestExpenses && !trip(tripId).locked
                && hasValidBinding(tripId)
                && request.resource.data.createdBy == 'guest'
                && 'createdByUid' in request.resource.data
                && request.resource.data.createdByUid == request.auth.uid
                && 'createdByMemberId' in request.resource.data
                && request.resource.data.createdByMemberId == myMemberId(tripId)) );

        // Cho phép cập nhật khoản chi hợp lệ mà không đổi createdAt/createdBy/createdByUid/createdByMemberId: admin sửa mọi khoản, khách chỉ sửa khoản do chính thành viên mình tạo khi chuyến mở, cho phép nhập và binding còn hiệu lực.
        allow update: if tripExists(tripId)
          && validExpense(request.resource.data, trip(tripId))
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.createdBy == resource.data.createdBy
          && sameOptField(request.resource.data, resource.data, 'createdByUid')
          && sameOptField(request.resource.data, resource.data, 'createdByMemberId')
          && ( isAdmin()
            || (trip(tripId).allowGuestExpenses && !trip(tripId).locked
                && hasValidBinding(tripId)
                && resource.data.createdBy == 'guest'
                && 'createdByMemberId' in resource.data
                && resource.data.createdByMemberId == myMemberId(tripId)) );

        // Admin được xóa mọi khoản chi; khách chỉ được xóa khoản createdBy=='guest' thuộc đúng memberId của mình khi chuyến tồn tại, chưa khóa, đang cho phép nhập và binding hợp lệ.
        allow delete: if isAdmin()
          || (tripExists(tripId)
              && trip(tripId).allowGuestExpenses && !trip(tripId).locked
              && hasValidBinding(tripId)
              && resource.data.createdBy == 'guest'
              && 'createdByMemberId' in resource.data
              && resource.data.createdByMemberId == myMemberId(tripId));
      }

      match /payments/{paymentId} {
        // Bất kỳ ai có tripId của chuyến đang tồn tại đều đọc được lịch sử thanh toán của chuyến đó.
        allow read: if tripExists(tripId);

        // Cho phép ghi nhận thanh toán hợp lệ khi chuyến tồn tại: admin ghi markedBy='admin' (không gắn UID/memberId khách), hoặc khách có binding hợp lệ ghi markedBy='guest' cho giao dịch liên quan tới chính memberId của mình khi chuyến chưa khóa.
        allow create: if tripExists(tripId)
          && validPayment(request.resource.data, trip(tripId))
          && ( (isAdmin()
                && request.resource.data.markedBy == 'admin'
                && !('createdByUid' in request.resource.data)
                && !('createdByMemberId' in request.resource.data))
            || (!trip(tripId).locked
                && hasValidBinding(tripId)
                && request.resource.data.markedBy == 'guest'
                && 'createdByUid' in request.resource.data
                && request.resource.data.createdByUid == request.auth.uid
                && 'createdByMemberId' in request.resource.data
                && request.resource.data.createdByMemberId == myMemberId(tripId)
                && (myMemberId(tripId) == request.resource.data.fromId
                    || myMemberId(tripId) == request.resource.data.toId)) );

        // Cấm hoàn toàn cập nhật bản ghi thanh toán để giữ tính toàn vẹn sổ cái (muốn sửa phải xóa rồi tạo lại).
        allow update: if false;   // muốn sửa thì xóa rồi tạo lại

        // Admin được xóa mọi bản ghi thanh toán; khách chỉ được hoàn tác bản ghi markedBy=='guest' thuộc đúng memberId của mình khi chuyến tồn tại, chưa khóa và binding hợp lệ.
        allow delete: if isAdmin()
          || (tripExists(tripId)
              && !trip(tripId).locked
              && hasValidBinding(tripId)
              && resource.data.markedBy == 'guest'
              && 'createdByMemberId' in resource.data
              && resource.data.createdByMemberId == myMemberId(tripId));
      }

      match /memberQrs/{memberId} {
        // Bất kỳ ai có tripId của chuyến đang tồn tại đều đọc được ảnh QR MoMo tĩnh của thành viên trong chuyến.
        allow read: if tripExists(tripId);
        // Chỉ admin được tạo hoặc cập nhật ảnh QR MoMo cho thành viên thuộc memberIds (chống khách tráo mã QR nhận tiền); dùng existsAfter/getAfter để hỗ trợ ghi nguyên tử trips và memberQrs trong cùng một writeBatch khi tạo chuyến mới hoặc thêm thành viên mới có ảnh QR.
        allow create, update: if isAdmin() && existsAfter(tripPath(tripId))
          && memberId in getAfter(tripPath(tripId)).data.memberIds
          && exactKeys(request.resource.data, ['dataUrl','updatedAt'])
          && isQrDataUrl(request.resource.data.dataUrl)
          && request.resource.data.updatedAt == request.time;
        // Chỉ admin được xóa ảnh QR MoMo của thành viên.
        allow delete: if isAdmin();
      }

      match /memberSecrets/{memberId} {
        // Chỉ admin được đọc hoặc xóa mã bí mật của thành viên để tránh lộ link mời riêng sang khách khác.
        allow read, delete: if isAdmin();
        // Chỉ admin được tạo hoặc xoay vòng mã bí mật [a-z0-9]{12,32} cho thành viên nằm trong memberIds sau khi ghi (hỗ trợ writeBatch cùng trips).
        allow create, update: if isAdmin()
          && existsAfter(tripPath(tripId))
          && memberId in getAfter(tripPath(tripId)).data.memberIds
          && exactKeys(request.resource.data, ['code', 'updatedAt'])
          && isValidMemberCode(request.resource.data.code)
          && request.resource.data.updatedAt == request.time;
      }

      match /bindings/{uid} {
        // Admin hoặc chính chủ UID được đọc trạng thái binding của mình (cho phép get khi doc chưa tồn tại hoặc khi memberId và code còn khớp memberSecrets hiện hành).
        allow get: if isAdmin()
          || (request.auth != null
              && request.auth.uid == uid
              && (resource == null
                  || (tripExists(tripId)
                      && resource.data.memberId in trip(tripId).memberIds
                      && secretMatches(tripId, resource.data.memberId, resource.data.code))));
        // Chỉ admin được liệt kê danh sách binding của chuyến đi để tránh khách dò UID hoặc danh tính đã liên kết của người khác.
        allow list: if isAdmin();
        // Chỉ khách (không phải admin) đã đăng nhập đúng UID mới được tự tạo hoặc cập nhật binding cho mình khi cung cấp đúng memberId thuộc chuyến và code khớp memberSecrets.
        allow create, update: if !isAdmin()
          && request.auth != null
          && request.auth.uid == uid
          && tripExists(tripId)
          && exactKeys(request.resource.data, ['memberId', 'code', 'updatedAt'])
          && request.resource.data.memberId in trip(tripId).memberIds
          && isValidMemberCode(request.resource.data.code)
          && secretMatches(tripId, request.resource.data.memberId, request.resource.data.code)
          && request.resource.data.updatedAt == request.time;
        // Admin hoặc chính chủ UID được xóa binding (cho phép khách tự hủy liên kết khi đổi người hoặc thu hồi phiên).
        allow delete: if isAdmin() || (request.auth != null && request.auth.uid == uid);
      }
    }

    match /{document=**} {
      // Mặc định từ chối mọi thao tác đọc/ghi trên bất kỳ đường dẫn nào ngoài các collection đã khai báo.
      allow read, write: if false;   // mặc định chặn mọi thứ khác
    }
  }
}
